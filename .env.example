# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/law_ai?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/law_ai?schema=public"

# docker-compose reads these directly for the postgres service (and to build api's
# DATABASE_URL/DIRECT_URL above for the docker-network hostname) — keep in sync with the
# credentials embedded in DATABASE_URL/DIRECT_URL above. Change these to a long random
# password for any real deployment — never leave as the "postgres" default in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=law_ai
POSTGRES_PORT=5434

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# LLM — OpenRouter (chat completions)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4-flash"

# Embeddings — OpenAI (direct, not via OpenRouter)
OPENAI_API_KEY=""
EMBEDDING_MODEL="openai/text-embedding-3-small"

# API
PORT=4002
WEB_ORIGIN="http://localhost:3002"

# Web
NEXT_PUBLIC_API_BASE_URL="http://localhost:4002"
WEB_PORT=3002
