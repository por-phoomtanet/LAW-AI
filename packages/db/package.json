{
  "name": "@law-ai/db",
  "private": true,
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "bun src/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "db:execute": "prisma db execute"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  },
  "prisma": {
    "seed": "bun run src/seed.ts"
  }
}
