generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  menuKey   String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([roleId, menuKey])
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?
  conversations Conversation[]
}

// เอกสารกฎหมายต้นฉบับ 1 รายการ (กฎหมาย 1 ฉบับ / คำพิพากษา 1 คดี)
model LegalDocument {
  id           Int             @id @default(autoincrement())
  type         String // "statute" | "court_decision" | "regulation"
  title        String
  citationCode String? // เช่น "มาตรา 420 ป.พ.พ." หรือเลขคดี
  sourceUrl    String?
  publishedAt  DateTime?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  chunks       DocumentChunk[]

  @@index([type])
}

// Chunk ระดับมาตรา/ย่อหน้า พร้อม embedding สำหรับ semantic search
model DocumentChunk {
  id          Int                          @id @default(autoincrement())
  documentId  Int
  document    LegalDocument                @relation(fields: [documentId], references: [id])
  content     String                       @db.Text
  chunkIndex  Int
  contentHash String // dedupe ก่อน re-embed
  embedding   Unsupported("vector(1536)") // 1536 มิติ = text-embedding-3-small ของ OpenAI (EMBEDDING_MODEL)
  createdAt   DateTime                     @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// ─── คลังกฎหมาย: Document/DocumentVersion/Passage (Phase 4 — browse ตามหมวดหมู่ + TOC) ───
// Port จาก branch chore/trim-schema-phase-1-2 แบบตัดทอน — ไม่เอา Workspace/multi-tenancy,
// CourtCaseMeta, LegalTopic/DocumentTopic, InlineReference, ResearchSession ฯลฯ (เหตุผล
// แต่ละจุด ดู CLAUDE.md § Phase 4) ไม่ใช่ RAG corpus — ไม่มี embedding เพราะ scope รอบนี้คือ
// browse ตามหมวดหมู่ + TOC รายมาตราเท่านั้น ไม่ใช่ semantic search — ไม่แตะ LegalDocument/
// DocumentChunk เดิมที่ seed/chat ใช้อยู่

// เอกสารกฎหมาย — "ตัวตน" ที่คงที่ข้ามการแก้ไข/เวอร์ชัน (lawCode = law_code จาก ocs-krisdika
// ใช้ผูกทุกเวอร์ชันของกฎหมายฉบับเดียวกันเข้าด้วยกัน) docType ใช้คำนวณ "หมวดหมู่" (กฎหมายหลัก/
// ลำดับรอง) ฝั่ง backend แทนการเก็บเป็น column แยก (ดู packages/core/src/documentCategory.ts)
model Document {
  id           Int               @id @default(autoincrement())
  lawCode      String            @unique
  title        String
  docType      String
  citationCode String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  versions     DocumentVersion[]

  @@index([docType])
}

// 1 เวอร์ชัน = 1 การแก้ไขของกฎหมาย (= timeline_code) — กฎหมายไทยหลายฉบับมีหลายเวอร์ชันจริง
// (พ.ร.บ.ลิขสิทธิ์ 2537 มี 7 เวอร์ชันใน ocs-krisdika) ต้อง filter isLatest เสมอตอน query
// เพื่อไม่ให้โชว์มาตราที่ถูกยกเลิกไปแล้ว — isLatest คำนวณจาก timeline_code suffix ตัวเลข
// สูงสุดตอน ingest ไม่เชื่อ record.is_latest จาก raw dataset ตรงๆ (พิสูจน์แล้วว่าเชื่อไม่ได้)
model DocumentVersion {
  id            Int       @id @default(autoincrement())
  documentId    Int
  document      Document  @relation(fields: [documentId], references: [id])
  versionLabel  String
  externalId    String?
  sourceUrl     String?
  effectiveFrom DateTime?
  isLatest      Boolean   @default(false)
  contentHash   String
  createdAt     DateTime  @default(now())
  passages      Passage[]

  @@unique([documentId, versionLabel])
  @@index([documentId, isLatest])
}

// 1 มาตรา/หมวด/ส่วนที่ ต่อ 1 แถว — sectionType มาจาก sectionTypeId ของ ocs-krisdika ตรงๆ
// (verify แล้วจากข้อมูลจริง ไม่ต้องเดา): 1,3=title/preamble, 4=มาตรา (section), 8=หมวด
// (chapter), 9=ส่วนที่ (part), 2,13,14,15=royal_name/transitional/signatory/note
// parentId ผูก หมวด → ส่วนที่ → มาตรา เป็น tree สำหรับ TOC โดยไม่ต้อง parse ข้อความเดา
model Passage {
  id            Int             @id @default(autoincrement())
  versionId     Int
  version       DocumentVersion @relation(fields: [versionId], references: [id])
  ordinal       Int
  sectionType   String
  sectionNumber String?
  parentId      Int?
  parent        Passage?        @relation("PassageChildren", fields: [parentId], references: [id])
  children      Passage[]       @relation("PassageChildren")
  content       String          @db.Text
  contentHash   String
  createdAt     DateTime        @default(now())
  // generated column (to_tsvector) + GIN/trgm index สร้างผ่าน raw SQL migration
  // (Phase 5.3) — Prisma ไม่รู้จัก GENERATED ALWAYS AS ประกาศเป็น Unsupported ไว้
  // กัน `migrate dev` เห็นเป็น drift แล้วพยายามลบคอลัมน์นี้ทิ้ง
  searchVector  Unsupported("tsvector")?

  @@unique([versionId, ordinal])
  @@index([versionId])
  @@index([versionId, parentId])
}

// รายชื่อโมเดล AI ที่เปิดให้ผู้ใช้เลือกได้ (ทั้งแชททั่วไปและแชทกฎหมาย) — ดึงจาก DB แทนการ
// hardcode ในโค้ด เพื่อเพิ่ม/ปิดโมเดลได้โดยไม่ต้อง deploy ใหม่ (Phase 5.1)
model AiModel {
  id        Int      @id @default(autoincrement())
  modelId   String   @unique // OpenRouter model id ตรงๆ เช่น "anthropic/claude-opus-5"
  label     String // ชื่อโชว์ผู้ใช้ เช่น "Claude Opus 5"
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  modelTier String    @default("deepseek/deepseek-v4-flash") // เก็บ OpenRouter model id ตรงๆ ไม่ใช่ enum tier
  mode      String    @default("general") // "general" | "legal" (Phase 5.3) — แยกแชททั่วไป/แชทกฎหมาย
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  deletedAt DateTime?
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // "user" | "assistant"
  content        String       @db.Text
  citations      Json? // เฉพาะแชทกฎหมาย (Phase 5.5) — [{ index, passageId, documentId, citationLabel }] ที่ validate แล้วว่าตรงกับ passage ที่ retrieve จริง; general chat ไม่ใช้ field นี้เลย (null เสมอ)
  modelUsed      String? // model id ที่ใช้ตอบจริง (เผื่อ fallback)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
