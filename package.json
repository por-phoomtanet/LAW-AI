{
  "name": "law-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build:api": "cd apps/api && bun run build",
    "build:web": "cd apps/web && bun run build",
    "db:generate": "cd packages/db && bun run generate",
    "db:migrate:dev": "cd packages/db && bun run migrate:dev",
    "db:push": "cd packages/db && bun run db:push",
    "db:migrate": "cd packages/db && bun run db:migrate",
    "db:seed": "cd packages/db && bun run db:seed",
    "db:reset": "cd packages/db && bun run db:reset",
    "db:setup": "cd packages/db && bun run db:setup",
    "db:execute": "cd packages/db && bun run db:execute",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
